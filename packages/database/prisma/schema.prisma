datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  MERCHANT
  DRIVER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ESEWA
  KHALTI
  COD
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum KDSTicketStatus {
  NEW
  IN_PROGRESS
  READY
  DISPATCHED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?        @unique
  passwordHash String
  role         UserRole       @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders       Order[]        @relation("CustomerOrders")
  driverOrders Order[]        @relation("DriverOrders")
  driverProfile DriverProfile?
  restaurants  Restaurant[]   @relation("MerchantRestaurants")

  @@map("users")
}

model Restaurant {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  address     String
  city        String         @default("Kathmandu")
  latitude    Float
  longitude   Float
  phone       String
  email       String?
  bannerUrl   String?
  logoUrl     String?
  isOpen      Boolean        @default(true)
  rating      Float          @default(4.8)
  kdsEnabled  Boolean        @default(true)
  merchantId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  merchant    User           @relation("MerchantRestaurants", fields: [merchantId], references: [id])
  categories  MenuCategory[]
  menuItems   MenuItem[]
  orders      Order[]
  kdsTickets  KDSLiveTicket[]

  @@map("restaurants")
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              String        @id @default(cuid())
  restaurantId    String
  categoryId      String?
  name            String
  description     String?
  price           Float
  discountedPrice Float?
  imageUrl        String?
  isAvailable     Boolean       @default(true)
  isVeg           Boolean       @default(false)
  isSpicy         Boolean       @default(false)
  spiceLevel      Int           @default(1)
  prepTimeMinutes Int           @default(20)
  calories        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category        MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]

  @@map("menu_items")
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  customerId            String
  restaurantId          String
  driverId              String?
  status                OrderStatus       @default(PENDING)
  subtotal              Float
  deliveryFee           Float             @default(50.0)
  tax                   Float             @default(0.0)
  discount              Float             @default(0.0)
  totalAmount           Float
  deliveryAddress       String
  deliveryLat           Float
  deliveryLng           Float
  deliveryInstructions  String?
  estimatedDeliveryTime DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  customer              User              @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id])
  driver                User?             @relation("DriverOrders", fields: [driverId], references: [id])
  orderItems            OrderItem[]
  payments              Payment[]
  kdsTicket             KDSLiveTicket?

  @@map("orders")
}

model OrderItem {
  id                  String    @id @default(cuid())
  orderId             String
  menuItemId          String
  name                String
  price               Float
  quantity            Int       @default(1)
  specialInstructions String?

  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            MenuItem  @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Float
  method          PaymentMethod @default(ESEWA)
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @unique
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model DriverProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  vehicleType        String             @default("Motorbike")
  vehiclePlate       String
  licenseNumber      String
  isOnline           Boolean            @default(false)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?
  rating             Float              @default(5.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationLogs       RiderLocationLog[]

  @@map("driver_profiles")
}

model RiderLocationLog {
  id        String        @id @default(cuid())
  driverId  String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  timestamp DateTime      @default(now())

  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("rider_location_logs")
}

model KDSLiveTicket {
  id               String          @id @default(cuid())
  orderId          String          @unique
  restaurantId     String
  station          String          @default("Main Kitchen")
  status           KDSTicketStatus @default(NEW)
  ticketNotes      String?
  timerStartedAt   DateTime?
  timerCompletedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant       Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("kds_live_tickets")
}
